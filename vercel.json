{
  "version": 2,
  "public": false,
  "framework": "angular",
  "outputDirectory": "/dist/hex-impact-rpg/browser",
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "dist/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "dist/api/index.js"
    }
  ]
}
