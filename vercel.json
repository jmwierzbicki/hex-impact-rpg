{
  "version": 2,
  "public": false,
  "framework": "angular",
  "outputDirectory": "/dist/hex-impact-rpg/browser",
  "buildCommand": "npm run build",
  "functions": {
    "api/server/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/server/index.js"
    }
  ]
}
